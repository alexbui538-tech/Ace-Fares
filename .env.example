# Set these in Netlify: Site configuration > Environment variables. Never put real values in this file or in index.html.
STRIPE_SECRET_KEY=sk_test_...        # Stripe Dashboard > Developers > API keys (use the TEST key first)
STRIPE_PUBLISHABLE_KEY=pk_test_...   # Stripe Dashboard > Developers > API keys > Publishable key. Turns on the on-site checkout page
STRIPE_WEBHOOK_SECRET=whsec_...      # Stripe Dashboard > Developers > Webhooks > your endpoint > Signing secret
ADMIN_KEY=choose-a-long-random-password   # lets you view all bookings at /api/admin/bookings
GMAIL_USER=acefaresrental@gmail.com    # sends booking confirmations + rental agreement
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx  # Google Account > Security > App passwords (needs 2-Step Verification)
OWNER_EMAIL=acefaresrental@gmail.com   # optional: gets a copy of every confirmation
REQUIRE_TERMS=true                     # only after saving the terms URL at dashboard.stripe.com/settings/public
# SITE_URL=https://acefaresrental.com    # optional; Netlify's own URL is used if this is empty
